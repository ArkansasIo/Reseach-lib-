{
  "name": "neural-research-lib",
  "version": "0.2.0",
  "private": true,
  "description": "TypeScript research platform with MySQL, Wolfram|Alpha mathematics, AI/neural-network research, provenance, and scheduled jobs",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "research": "tsx src/cli.ts research",
    "math": "tsx src/cli.ts math",
    "jobs": "tsx src/cli.ts jobs",
    "db:migrate": "tsx src/cli.ts migrate",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.2.5",
    "mysql2": "^3.15.3",
    "node-cron": "^4.2.1",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}